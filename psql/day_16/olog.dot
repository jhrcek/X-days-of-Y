digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  simple [label="the simple\nquery protocol", fillcolor="#f4efe6"];
  ext    [label="the extended\nquery protocol", fillcolor="#e7f0ec", color="#2f7a63"];
  bind   [label="a parameter binding", fillcolor="#e7f0ec", color="#2f7a63"];
  stmt   [label="a prepared statement", fillcolor="#e7f0ec", color="#2f7a63"];
  pipe   [label="a pipeline", fillcolor="#e7f0ec", color="#2f7a63"];
  sync   [label="a sync point"];
  ab     [label="an aborted pipeline", fillcolor="#f8efdf", color="#d8b784"];

  simple -> ext  [label="  is replaced, for one query, by"];
  bind   -> ext  [label="switches psql to  "];
  bind   -> stmt [label="  is made against"];
  stmt   -> ext  [label="  requires"];
  pipe   -> ext  [label="  uses, throughout,"];
  pipe   -> sync [label="is punctuated by  "];
  ab     -> pipe [label="  is a state of"];
  sync   -> ab   [label="  clears", style=dashed];

}
