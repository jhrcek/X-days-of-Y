digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  res  [label="a result set", fillcolor="#e7f0ec", color="#2f7a63"];
  fmt  [label="an output format", fillcolor="#e7f0ec", color="#2f7a63"];
  txt  [label="the text psql prints", fillcolor="#e7f0ec", color="#2f7a63"];
  gen  [label="a general option\n(null, footer, border)"];
  spec [label="a format-specific option\n(linestyle, fieldsep, csv_fieldsep)", fillcolor="#f8efdf", color="#d8b784"];
  pgr  [label="the pager"];
  term [label="your terminal", fillcolor="#f4efe6"];

  res  -> fmt  [label="  is rendered by"];
  fmt  -> txt  [label="  produces"];
  gen  -> txt  [label="  affects"];
  spec -> fmt  [label="belongs to  "];
  txt  -> term [label="  is written to"];
  txt  -> pgr  [label="may first be piped to  ", style=dashed];
  pgr  -> term [label="writes to  "];

}
