digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  q     [label="a query", fillcolor="#e7f0ec", color="#2f7a63"];
  qout  [label="the query-output channel", fillcolor="#e7f0ec", color="#2f7a63"];
  out   [label="psql's standard output"];
  dest  [label="a file or a pipe", fillcolor="#e7f0ec", color="#2f7a63"];
  msg   [label="an error message"];
  errch [label="psql's standard error", fillcolor="#f8efdf", color="#d8b784"];

  q    -> qout  [label="  writes its result to"];
  qout -> out   [label="  is, by default,"];
  qout -> dest  [label="is pointed at, by \\o or \\g,  ", style=dashed];
  q    -> msg   [label="can produce  ", style=dashed];
  msg  -> errch [label="  always goes to"];

}
