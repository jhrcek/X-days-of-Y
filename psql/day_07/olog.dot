digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  line [label="a line you type", fillcolor="#f4efe6"];
  rl   [label="readline", fillcolor="#e7f0ec", color="#2f7a63"];
  hist [label="the history file\n(HISTFILE)", fillcolor="#e7f0ec", color="#2f7a63"];
  buf  [label="the query buffer", fillcolor="#e7f0ec", color="#2f7a63"];
  tmp  [label="a temporary file\n/tmp/psql.edit.PID.sql", fillcolor="#f8efdf", color="#d8b784"];
  ed   [label="your editor", fillcolor="#f4efe6"];

  line -> rl   [label="  is edited by"];
  rl   -> hist [label="appends it to  "];
  rl   -> buf  [label="  hands the finished line to"];
  hist -> rl   [label="  is recalled by", style=dashed, constraint=false];
  buf  -> tmp  [label="  is copied into, by \\e"];
  tmp  -> ed   [label="  is opened in"];
  ed   -> buf  [label="replaces  ", style=dashed, constraint=false];

}
