digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  cmd  [label="a describe command", fillcolor="#e7f0ec", color="#2f7a63"];
  let  [label="an object-type letter\n(t, i, v, m, s, E, n, f, …)"];
  mod  [label="a modifier\n(S, +, x)"];
  pat  [label="a pattern", fillcolor="#e7f0ec", color="#2f7a63"];
  qry  [label="a catalogue query"];
  obj  [label="a catalogue object", fillcolor="#e7f0ec", color="#2f7a63"];
  path [label="the schema\nsearch path", fillcolor="#f8efdf", color="#d8b784"];

  cmd  -> let  [label="  chooses its objects with"];
  cmd  -> mod  [label="is qualified by  ", style=dashed];
  cmd  -> pat  [label="  is narrowed by", style=dashed];
  cmd  -> qry  [label="  is compiled into"];
  qry  -> obj  [label="  returns"];
  pat  -> obj  [label="  matches the name of"];
  path -> obj  [label="  decides the visibility of"];

}
