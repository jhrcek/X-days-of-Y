cabal-version:      3.0
name:               site
version:            1.0.0
synopsis:           Builds every course and the repository-root landing page
build-type:         Simple

executable build-site
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base           >=4.17 && <5,
        text,
        filepath,
        course-builder,
        tmux-course
    default-language: GHC2021
    default-extensions: OverloadedStrings
    ghc-options: -Wall
