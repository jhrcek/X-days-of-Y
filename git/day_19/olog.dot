digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  script  [label="a script", fillcolor="#f4efe6"];
  plumb   [label="a plumbing command\n(rev-parse, for-each-ref…)", fillcolor="#e7f0ec", color="#2f7a63"];
  fmt     [label="a stable format flag\n(--porcelain=v2, --format, -z)", fillcolor="#e7f0ec", color="#2f7a63"];
  porc    [label="a porcelain command\n(status, log, branch)"];
  human   [label="human-readable output", fillcolor="#f8efdf", color="#d8b784"];
  repo    [label="a repository"];
  spec    [label="a pathspec"];

  porc   -> fmt    [label="  offers"];
  porc   -> human  [label="  prints by default"];
  fmt    -> script [style=invis];
  script -> fmt    [label="  asks for  ", constraint=false];
  human  -> script [label="  may change under", style=dashed];
  script -> plumb  [label="  calls"];
  script -> repo   [label="  names with -C"];
  script -> spec   [label="  selects paths by"];

  { rank=same; fmt; human; }

}
