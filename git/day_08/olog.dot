digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  reset   [label="git reset", fillcolor="#e7f0ec", color="#2f7a63"];
  restore [label="git restore", fillcolor="#e7f0ec", color="#2f7a63"];
  revert  [label="git revert", fillcolor="#e7f0ec", color="#2f7a63"];
  branch  [label="a branch"];
  index   [label="the index"];
  wt      [label="the working tree", fillcolor="#f4efe6"];
  newc    [label="a new commit", fillcolor="#f8efdf", color="#d8b784"];
  old     [label="an old commit"];

  reset   -> branch [label="  moves"];
  reset   -> index  [label="  overwrites (mixed, hard)", style=dashed];
  reset   -> wt     [label="  overwrites (hard)", style=dashed];
  restore -> wt     [label="  overwrites files in"];
  restore -> index  [label="  overwrites (--staged)", style=dashed];
  revert  -> newc   [label="  adds"];
  newc    -> old    [label="  undoes the changes of"];
  newc    -> branch [label="  is added on top of"];

  { rank=same; reset; restore; revert; }

}
