digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  ref    [label="a ref\n(HEAD, a branch)", fillcolor="#e7f0ec", color="#2f7a63"];
  log    [label="a reflog", fillcolor="#e7f0ec", color="#2f7a63"];
  entry  [label="a reflog entry"];
  commit [label="a commit"];
  why    [label="a reason and a time", fillcolor="#f4efe6"];
  expr   [label="an expression\nHEAD@{n}, main@{yesterday}"];
  gc     [label="garbage collection"];
  work   [label="uncommitted work", fillcolor="#f8efdf", color="#d8b784"];

  ref    -> log    [label="  has"];
  log    -> entry  [label="  is a list of"];
  entry  -> commit [label="  records as the new position"];
  entry  -> why    [label="  records"];
  expr   -> entry  [label="  selects"];
  entry  -> gc     [label="  protects its commit from", style=dashed];
  entry  -> work   [label="  never records", style=dashed];

  { rank=same; ref; expr; }

}
