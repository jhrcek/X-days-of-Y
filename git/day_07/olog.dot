digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  expr   [label="a revision expression", fillcolor="#f4efe6"];
  ref    [label="a ref"];
  commit [label="a commit", fillcolor="#e7f0ec", color="#2f7a63"];
  blob   [label="a blob or tree"];
  path   [label="a path", fillcolor="#f4efe6"];
  base   [label="a merge base"];
  set    [label="a set of commits", fillcolor="#f8efdf", color="#d8b784"];

  expr   -> ref    [label="  may start at"];
  ref    -> commit [label="  resolves to"];
  commit -> commit [label="  has as first parent (~)"];
  commit -> commit [label="  has as n-th parent (^n)", style=dashed];
  commit -> blob   [label="  contains at a path (:)"];
  blob   -> path   [label="  is found at"];
  commit -> base   [label="  shares with another commit"];
  set    -> commit [label="  includes what is reachable from"];
  set    -> commit [label="  excludes what is reachable from (^)", style=dashed];

  { rank=same; expr; set; }

}
