digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  path   [label="a path", fillcolor="#e7f0ec", color="#2f7a63"];
  untr   [label="an untracked path"];
  trk    [label="a tracked path", fillcolor="#f8efdf", color="#d8b784"];
  pat    [label="an ignore pattern", fillcolor="#e7f0ec", color="#2f7a63"];
  src    [label="an ignore source\n(.gitignore > info/exclude\n> core.excludesFile)"];
  attr   [label="an attribute\n(text, eol, diff, merge, ...)", fillcolor="#e7f0ec", color="#2f7a63"];
  gafile [label="a .gitattributes line"];
  drv    [label="a diff driver"];
  prog   [label="a textconv program", fillcolor="#f4efe6"];

  untr -> path   [label="  is"];
  trk  -> path   [label="  is"];
  untr -> pat    [label="  may be ignored by"];
  pat  -> src    [label="  comes from"];
  path -> attr   [label="  has"];
  attr -> gafile [label="  is set by"];
  attr -> drv    [label="  may name", style=dashed];
  drv  -> prog   [label="  runs"];

  { rank=same; untr; trk; }

}
