digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  alien  [label="an untrusted .git directory", fillcolor="#f8efdf", color="#d8b784"];
  cfg    [label="its config and hooks"];
  cmds   [label="a shell command", fillcolor="#f4efe6"];
  objs   [label="its objects and refs", fillcolor="#e7f0ec", color="#2f7a63"];
  clone  [label="a clean clone", fillcolor="#e7f0ec", color="#2f7a63"];
  check  [label="the ownership check"];
  safe   [label="safe.directory\n(protected config only)"];
  fsck   [label="transfer.fsckObjects"];

  alien -> cfg   [label="  contains"];
  alien -> objs  [label="  contains"];
  cfg   -> cmds  [label="  can run"];
  clone -> objs  [label="  receives"];
  clone -> cfg   [label="  never receives", style=dashed];
  fsck  -> objs  [label="  checks, when transferred,"];
  check -> alien [label="  refuses, if another user owns,"];
  safe  -> check [label="  makes exceptions to"];

  { rank=same; check; safe; }

}
