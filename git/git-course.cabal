cabal-version:      3.0
name:               git-course
version:            1.0.0
synopsis:           "21 Days of git" - the course content
description:
  Twenty-one lessons distilled from git(1) and the pages it delegates to
  (gitrevisions(7), gitglossary(7), gitignore(5), gitattributes(5), githooks(5)
  and the subcommand pages), written as Lucid markup against the course-builder
  library. @cabal run git-course@ regenerates just this course; @cabal run
  build-site@ at the repository root regenerates everything.
build-type:         Simple

common shared
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
        LambdaCase
    ghc-options: -Wall -Wno-missing-signatures

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Courses.Git
    other-modules:
        Course.Day.D01
        Course.Day.D02
        Course.Day.D03
        Course.Day.D04
        Course.Day.D05
        Course.Day.D06
        Course.Day.D07
        Course.Day.D08
        Course.Day.D09
        Course.Day.D10
        Course.Day.D11
        Course.Day.D12
        Course.Day.D13
        Course.Day.D14
        Course.Day.D15
        Course.Day.D16
        Course.Day.D17
        Course.Day.D18
        Course.Day.D19
        Course.Day.D20
        Course.Day.D21
    build-depends:
        base   >=4.17 && <5,
        text   >=2.0,
        lucid  >=2.11,
        course-builder

executable git-course
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base,
        filepath,
        course-builder,
        git-course
