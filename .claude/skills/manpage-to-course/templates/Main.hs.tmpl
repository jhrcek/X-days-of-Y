-- Save as <SLUG>/app/Main.hs.  Substitute: SLUG, TOOLMOD.
-- | @cabal run SLUG-course@ regenerates this course in place, from anywhere
-- inside the repository.
module Main (main) where

import System.FilePath ((</>))

import Course.Build (buildCourse, findRepoRoot)
import Courses.TOOLMOD (course)

main :: IO ()
main = do
  root <- findRepoRoot
  buildCourse (root </> "SLUG") course
