digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  src   [label="the source tree", fillcolor="#e7f0ec", color="#2f7a63"];
  bin   [label="the behaviour\nof the binary", fillcolor="#e7f0ec", color="#2f7a63"];
  help  [label="--help and the\nF1 help screen"];
  page  [label="the manual page", fillcolor="#f8efdf", color="#d8b784"];
  edit  [label="a human who must\nremember to edit it", fillcolor="#f4efe6"];

  bin  -> src  [label="  is compiled from"];
  help -> src  [label="  is generated from"];
  page -> edit [label="  is maintained by"];
  page -> bin  [label="claims to describe  ", style=dashed, constraint=false];

}
