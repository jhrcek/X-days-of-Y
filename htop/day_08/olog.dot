digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  hdr   [label="the header", fillcolor="#e7f0ec", color="#2f7a63"];
  lay   [label="a header layout\n(1 to 4 columns)"];
  colm  [label="a header column"];
  mtr   [label="a meter", fillcolor="#e7f0ec", color="#2f7a63"];
  mode  [label="a display mode\n(bar/text/graph/LED)"];
  stat  [label="a machine-wide\nstatistic"];
  lib   [label="an optional library\nloaded at runtime", fillcolor="#f8efdf", color="#d8b784"];

  hdr  -> lay  [label="  is divided by"];
  hdr  -> colm [label="  contains"];
  colm -> mtr  [label="  lists"];
  mtr  -> mode [label="  is drawn in"];
  mtr  -> stat [label="  measures"];
  stat -> lib  [label="may require  ", style=dashed, constraint=false];

}
