digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  row    [label="a row"];
  flat   [label="the flat list", fillcolor="#e7f0ec", color="#2f7a63"];
  tree   [label="the tree view", fillcolor="#e7f0ec", color="#2f7a63"];
  col    [label="a sort column"];
  parent [label="a parent process"];
  sibs   [label="a set of sibling rows", fillcolor="#f8efdf", color="#d8b784"];

  flat -> row    [label="  contains"];
  flat -> col    [label="  orders every row by"];
  tree -> row    [label="  contains"];
  tree -> parent [label="  indents each row under"];
  row  -> parent [label="  has as parent"];
  sibs -> parent [label="  all share"];
  tree -> sibs   [label="  sorts only within"];
  tree -> flat   [label="replaces  ", style=dashed, constraint=false];

}
