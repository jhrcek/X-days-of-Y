digraph olog {
  bgcolor="transparent";
  rankdir=TB;
  splines=spline;
  nodesep=0.35;
  ranksep=0.45;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
        color="#d6cfc4", penwidth=1.1, fontname="Helvetica", fontsize=11.5,
        fontcolor="#23201c", margin="0.17,0.09", height=0.34];
  edge [color="#a09587", penwidth=1.05, fontname="Helvetica", fontsize=9.5,
        fontcolor="#6f675c", arrowsize=0.72];

  sess  [label="an htop session", fillcolor="#e7f0ec", color="#2f7a63"];
  file  [label="the htoprc file", fillcolor="#e7f0ec", color="#2f7a63"];
  setup [label="the Setup screen"];
  set   [label="a setting"];
  exit  [label="a clean exit after\nsomething changed"];
  cmt   [label="a comment you wrote", fillcolor="#f8efdf", color="#d8b784"];

  sess  -> file  [label="  reads once, at startup"];
  sess  -> setup [label="  contains"];
  setup -> set   [label="  edits"];
  file  -> set   [label="  stores"];
  exit  -> file  [label="  rewrites in full"];
  cmt   -> file  [label="  lives in"];
  exit  -> cmt   [label="destroys  ", style=dashed, constraint=false];

}
