cabal-version:      3.0
name:               tig-course
version:            1.0.0
synopsis:           "14 Days of tig" - the course content
description:
  Fourteen lessons distilled from tig(1), tigrc(5) and tigmanual(7), written as
  Lucid markup against the course-builder library. @cabal run tig-course@
  regenerates just this course; @cabal run build-site@ at the repository root
  regenerates everything.
build-type:         Simple

common shared
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
        LambdaCase
    ghc-options: -Wall -Wno-missing-signatures

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Courses.Tig
    other-modules:
        Course.Day.D01
        Course.Day.D02
        Course.Day.D03
        Course.Day.D04
        Course.Day.D05
        Course.Day.D06
        Course.Day.D07
        Course.Day.D08
        Course.Day.D09
        Course.Day.D10
        Course.Day.D11
        Course.Day.D12
        Course.Day.D13
        Course.Day.D14
    build-depends:
        base   >=4.17 && <5,
        text   >=2.0,
        lucid  >=2.11,
        course-builder

executable tig-course
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base,
        filepath,
        course-builder,
        tig-course
